# =============================================================================
# GEON — Nginx Configuration (TEMPLATE)
#
# Copy this file to geon.conf and replace geon.example.com with your real
# domain (geon.conf is gitignored — it carries the live domain + cert paths).
#
# GEON terminates its own TLS. Two entry modes:
#
#   - Passthrough SNI (VPS partage) : le proxy hote (odetowar-nginx) fait du
#     ssl_preread et forwarde le TCP 443 brut, avec proxy_protocol, vers le
#     listener 8443 ci-dessous. Voir docs/host_proxy_sni_passthrough.md.
#
#   - Standalone (hote dedie) : les ports 80/443 sont publies via
#     docker-compose.standalone.yml et le listener 443 recoit le TLS direct.
#
# Le serveur :80 reste compatible avec l'ancien montage (proxy hote qui
# termine le TLS et forwarde en HTTP avec X-Forwarded-Proto) et sert les
# challenges ACME (certbot webroot).
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP :80 — challenges ACME + compat ancien montage (TLS termine en amont)
# -----------------------------------------------------------------------------
server {
    listen 80;
    server_name geon.example.com;

    # Use the forwarded proto from the host reverse proxy for redirects
    set $real_scheme $scheme;
    if ($http_x_forwarded_proto) {
        set $real_scheme $http_x_forwarded_proto;
    }

    # ACME HTTP-01 challenges (certbot webroot). ^~ pour passer avant la
    # regex deny des fichiers caches.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/conf.d/geon-locations.inc;
}

# -----------------------------------------------------------------------------
# HTTPS — TLS termine par GEON (certs Let's Encrypt via le sidecar certbot)
#   :443  ssl                 -> standalone (ports publies) ou tests internes
#   :8443 ssl proxy_protocol  -> cible du passthrough SNI du proxy hote
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen 8443 ssl proxy_protocol;
    http2 on;
    server_name geon.example.com;

    ssl_certificate     /etc/letsencrypt/live/geon.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/geon.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:geon_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # IP cliente reelle transmise par le proxy hote via proxy_protocol
    # (ne s'applique qu'aux connexions arrivant sur le listener 8443).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header proxy_protocol;

    set $real_scheme https;

    # add_header au niveau server desactive l'heritage des headers du bloc
    # http : il faut redeclarer les headers de securite avec le HSTS.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/conf.d/geon-locations.inc;
}
